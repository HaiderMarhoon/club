<style>.metric{font-size:2rem;font-weight:800}.map{width:100%;max-width:430px;border-radius:12px}.shot-marker{cursor:pointer;transition:.15s}.shot-marker.selected{stroke:#fff!important;stroke-width:5!important}.shot-row{cursor:pointer}.shot-row.selected{--bs-table-bg:#d8fff4;font-weight:700}@media print{nav,footer,.no-print{display:none!important}body{background:#fff!important}.card{box-shadow:none!important}}</style>
<div id="reportApp" data-id="<%= matchId %>"><div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><div><h2 id="title">تقرير المباراة</h2><div id="subtitle" class="text-muted"></div></div><div class="no-print"><a id="backToLive" class="btn btn-primary d-none">↩ العودة إلى المباراة</a> <button class="btn btn-dark" onclick="window.print()">طباعة / PDF</button> <button id="exportBtn" class="btn btn-success" onclick="exportCsv()" disabled>تصدير إلى Excel</button> <% if (user && (user.isAdmin || user.isCoach)) { %><button class="btn btn-warning" onclick="editMatch()">تعديل اللقاء</button> <button id="deleteMatchBtn" class="btn btn-danger d-none" onclick="deleteMatch()">حذف اللقاء</button><% } %> <a class="btn btn-outline-primary" href="/match-reports">كل المباريات</a></div></div>
<div id="loading" class="alert alert-info">جارٍ إعداد التقرير…</div><main id="content" class="d-none">
 <div class="row g-3 mb-3" id="metrics"></div>
 <div class="card mb-3"><div class="card-header">التحليل الشامل للمباراة</div><div class="card-body"><div id="analysisMetrics" class="row g-3"></div><hr><h6>قراءة فنية آلية</h6><ul id="insights" class="mb-0"></ul></div></div>
 <div class="btn-group w-100 mb-3 no-print"><button id="filterAttack" class="btn btn-primary" onclick="setDistribution('attack')">هجومنا</button><button id="filterGoalkeepers" class="btn btn-outline-primary" onclick="setDistribution('goalkeepers')">تصويبات على حراسنا</button><button id="filterAll" class="btn btn-outline-primary" onclick="setDistribution('all')">عرض الكل</button></div>
 <div class="row g-3"><div class="col-lg-6"><div class="card h-100 bg-dark text-white"><div class="card-header">خريطة التسديدات من الملعب</div><div class="card-body text-center"><svg id="courtMap" class="map" viewBox="0 0 300 300" style="background:#071411"><rect x="5" y="5" width="290" height="290" fill="none" stroke="#e8f3f0" stroke-width="2"/><path d="M40 5 C42 92 85 115 150 115 C215 115 258 92 260 5" fill="none" stroke="#e8f3f0" stroke-width="2"/><path d="M5 54 C34 142 91 158 150 158 C209 158 266 142 295 54" fill="none" stroke="#e8f3f0" stroke-width="2" stroke-dasharray="3 3"/><line x1="146" y1="132" x2="154" y2="132" stroke="#e8f3f0" stroke-width="3"/><path d="M120 295 A30 30 0 0 1 180 295" fill="none" stroke="#60716d" stroke-width="2"/><g id="courtDots"/></svg></div></div></div><div class="col-lg-6"><div class="card h-100 bg-dark text-white"><div class="card-header">توزيع التسديدات في المرمى</div><div class="card-body text-center"><svg id="goalMap" class="map" viewBox="0 0 300 190" style="background:#071411"><defs><pattern id="reportStripe" width="28" height="28" patternUnits="userSpaceOnUse"><rect width="14" height="28" fill="#e8f3f0"/><rect x="14" width="14" height="28" fill="#078873"/></pattern></defs><path d="M30 175 V25 H270 V175" fill="none" stroke="url(#reportStripe)" stroke-width="12"/><path d="M30 75H270M30 125H270M110 25V175M190 25V175" stroke="#73827e" stroke-width="2" stroke-dasharray="7 7"/><g id="goalDots"/></svg><div class="small mt-2">أخضر: هدف · أحمر: خارج · أصفر: محجوبة · أزرق: تصدي</div></div></div></div></div>
 <div id="shotDetail" class="alert alert-secondary mt-3 text-center">اضغط على أي نقطة في الملعب أو المرمى لعرض مسار التسديدة وتفاصيلها.</div>
 <div class="card mt-3"><div class="card-header">جميع التسديدات — اضغط على التسديدة لعرض موقعها</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>الوقت</th><th>اللاعب</th><th>النوع</th><th>النتيجة</th></tr></thead><tbody id="shotsList"></tbody></table></div></div>
 <div class="card mt-3"><div class="card-header">إحصائيات اللاعبين والحراس</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>اللاعب</th><th>أهداف</th><th>تسديدات</th><th>دقة</th><th>تصديات/واجه</th><th>نسبة التصدي</th><th>مساعدات</th><th>استرجاع</th><th>فقدان</th><th>بلوك</th><th>إيقاف</th></tr></thead><tbody id="players"></tbody></table></div></div>
 <div class="card mt-3"><div class="card-header">التسديد حسب النوع</div><div class="card-body" id="shotTypes"></div></div>
 <div class="row g-3 mt-0"><div class="col-lg-6"><div class="card h-100"><div class="card-header">الأداء حسب الشوط</div><div class="card-body" id="periodAnalysis"></div></div></div><div class="col-lg-6"><div class="card h-100"><div class="card-header">أسباب الأخطاء الفنية</div><div class="card-body" id="technicalAnalysis"></div></div></div></div>
 <div class="card mt-3"><div class="card-header">سجل الأحداث</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>الوقت</th><th>اللاعب</th><th>الحدث</th><th>النتيجة</th></tr></thead><tbody id="timeline"></tbody></table></div></div>
</main></div>
<script>
(()=>{const id=document.getElementById('reportApp').dataset.id,$=x=>document.getElementById(x),esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));let match,events,rows,distributionMode='attack';
fetch('/matches/'+id).then(r=>r.json()).then(d=>{if(!d.success)throw Error(d.message);match=d.match;events=match.eventIds||[];build()}).catch(()=>{$('loading').className='alert alert-danger';$('loading').textContent='تعذر تحميل التقرير'});
function build(){$('loading').remove();$('content').classList.remove('d-none');$('title').textContent=match.name;$('subtitle').textContent=match.teamA+' × '+match.teamB+' — '+(match.status==='finished'?'منتهية':'مباشرة');if(match.status!=='finished'){$('backToLive').classList.remove('d-none');$('backToLive').href='/match-live?resume='+match._id}else if($('deleteMatchBtn'))$('deleteMatchBtn').classList.remove('d-none');let scoreA=0,scoreB=0,shots=0,goals=0,saves=0,turnovers=0;events.forEach(e=>{if((e.type==='shot'||e.type==='save')&&e.result==='goal')e.team==='B'?scoreB++:scoreA++;if(e.type==='shot'&&e.team==='A'){shots++;if(e.result==='goal')goals++}if(e.type==='save'&&e.result==='save')saves++;if(['turnover','technicalFault'].includes(e.type))turnovers++});let data=[['النتيجة',scoreA+' - '+scoreB],['دقة التسديد',shots?Math.round(goals/shots*100)+'%':'0%'],['التصديات',saves],['فقدان الكرة',turnovers]];$('metrics').innerHTML=data.map(x=>`<div class="col-6 col-lg-3"><div class="card text-center"><div class="card-body"><div class="text-muted">${x[0]}</div><div class="metric">${x[1]}</div></div></div></div>`).join('');players();maps();types();analysis();timeline()}
function players(){rows={};(match.roster||[]).forEach(p=>rows[p._id]={name:p.name,g:0,sh:0,sv:0,faced:0,a:0,st:0,t:0,b:0,s:0});events.forEach(e=>{if(e.playerId&&!rows[e.playerId])rows[e.playerId]={name:e.player||'—',g:0,sh:0,sv:0,faced:0,a:0,st:0,t:0,b:0,s:0};let r=rows[e.playerId];if(r){if(e.type==='shot'){r.sh++;if(e.result==='goal')r.g++}if(e.type==='save'){r.faced++;if(e.result==='save')r.sv++}if(e.type==='assist')r.a++;if(e.type==='steal')r.st++;if(['turnover','technicalFault'].includes(e.type))r.t++;if(e.type==='block')r.b++;if(e.type==='suspension')r.s++}if(e.assistPlayerId&&rows[e.assistPlayerId])rows[e.assistPlayerId].a++});$('players').innerHTML=Object.values(rows).map(r=>`<tr><td>${esc(r.name)}</td><td>${r.g}</td><td>${r.sh}</td><td>${r.sh?Math.round(r.g/r.sh*100):0}%</td><td>${r.sv}/${r.faced}</td><td>${r.faced?Math.round(r.sv/r.faced*100):0}%</td><td>${r.a}</td><td>${r.st}</td><td>${r.t}</td><td>${r.b}</td><td>${r.s}</td></tr>`).join('');$('exportBtn').disabled=false}
function dot(id,x,y,color,eventId){let c=document.createElementNS('http://www.w3.org/2000/svg','circle');Object.entries({cx:x,cy:y,r:7,fill:color,stroke:'#071411','stroke-width':2}).forEach(([k,v])=>c.setAttribute(k,v));c.classList.add('shot-marker');c.dataset.eventId=eventId;c.onclick=()=>selectShot(eventId);$(id).appendChild(c)}function maps(){$('courtDots').innerHTML='';$('goalDots').innerHTML='';let shots=events.filter(e=>distributionMode==='attack'?(e.type==='shot'&&e.team==='A'):distributionMode==='goalkeepers'?e.type==='save':(e.type==='shot'&&e.team==='A')||e.type==='save');shots.forEach(e=>{let color={goal:'#10b981',miss:'#ef4444',blocked:'#f59e0b',save:'#0dcaf0'}[e.result]||'#777';if(e.shotLocation){let[x,y]=e.shotLocation.split(',').map(Number);dot('courtDots',x*3,y*3,color,e._id)}if(e.goalDirection&&e.goalDirection!=='outside'){if(e.goalLocation){let[x,y]=e.goalLocation.split(',').map(Number);dot('goalDots',30+x*2.4,25+y*1.5,color,e._id)}else{let[r,c]=e.goalDirection.split('-');dot('goalDots',{left:70,center:150,right:230}[c],{top:50,mid:100,bottom:150}[r],color,e._id)}}});$('shotsList').innerHTML=shots.slice().reverse().map(e=>`<tr class="shot-row" data-event-id="${esc(e._id)}" onclick="selectShot('${esc(e._id)}')"><td>ش${esc(e.period)} · ${esc(e.matchTime||'--:--')}</td><td>${esc(e.player||'—')}</td><td>${e.type==='save'?'على الحارس · ':''}${esc(shotName(e.shotType))}</td><td>${esc(resultName(e.result))}</td></tr>`).join('')||'<tr><td colspan="4">لا توجد تسديدات في هذا العرض</td></tr>'}window.setDistribution=mode=>{distributionMode=mode;let names={attack:'Attack',goalkeepers:'Goalkeepers',all:'All'};['Attack','Goalkeepers','All'].forEach(n=>{$('filter'+n).className='btn '+(n===names[mode]?'btn-primary':'btn-outline-primary')});maps()};
function shotName(x){return({"7m":'7 أمتار',"6m":'6 أمتار',"9m":'9 أمتار',wing:'جناح',fastBreak:'هجمة مرتدة',breakthrough:'اختراق'}[x]||x||'غير محدد')}function resultName(x){return({goal:'هدف',miss:'خارج المرمى',blocked:'محجوبة',save:'تصدي الحارس'}[x]||x)}window.selectShot=id=>{document.querySelectorAll('.shot-marker,.shot-row').forEach(n=>n.classList.toggle('selected',n.dataset.eventId===id));let e=events.find(x=>x._id===id);if(!e)return;$('shotDetail').className='alert alert-dark mt-3 text-center';$('shotDetail').innerHTML=`<b>${esc(e.player||'—')}</b> · الشوط ${esc(e.period)} · ${esc(e.matchTime||'--:--')}<br>${e.type==='save'?'تصويبة على الحارس · ':''}${esc(shotName(e.shotType))} — <b>${esc(resultName(e.result))}</b><br><small>تم إبراز مكان الانطلاق وموقع الكرة في المرمى.</small>`;$('shotDetail').scrollIntoView({behavior:'smooth',block:'nearest'})};
function types(){let t={};events.filter(e=>e.type==='shot').forEach(e=>{let x=t[e.shotType||'غير محدد']||(t[e.shotType||'غير محدد']={all:0,g:0});x.all++;if(e.result==='goal')x.g++});$('shotTypes').innerHTML=Object.entries(t).map(([k,v])=>`<div class="mb-2"><div class="d-flex justify-content-between"><span>${esc(k)}</span><b>${v.g}/${v.all} (${Math.round(v.g/v.all*100)}%)</b></div><div class="progress"><div class="progress-bar bg-success" style="width:${v.g/v.all*100}%"></div></div></div>`).join('')||'لا توجد تسديدات'}function label(e){return({shot:'تسديدة',save:'حراسة',turnover:'فقدان',steal:'استرجاع',technicalFault:'خطأ فني',foul:'خطأ',block:'بلوك',assist:'مساعدة',lineTouch:'دخول المنطقة',suspension:'إيقاف',substitution:'تبديل'}[e.type]||e.type)}function timeline(){$('timeline').innerHTML=events.slice().reverse().map(e=>`<tr><td>ش${esc(e.period)} · ${esc(e.matchTime||'--:--')}</td><td>${esc(e.player||'الفريق')}</td><td>${esc(label(e))}</td><td>${esc(e.result||'—')}</td></tr>`).join('')}
function analysis(){let shots=events.filter(e=>e.type==='shot'&&e.team==='A'),goals=shots.filter(e=>e.result==='goal').length,turnovers=events.filter(e=>['turnover','technicalFault'].includes(e.type)).length,steals=events.filter(e=>e.type==='steal').length,assists=events.filter(e=>e.type==='assist'||e.assistPlayerId).length,blocks=events.filter(e=>e.type==='block').length,susp=events.filter(e=>e.type==='suspension').length,faced=events.filter(e=>e.type==='save'),saves=faced.filter(e=>e.result==='save').length,possessions=shots.length+turnovers,attackEff=possessions?Math.round(goals/possessions*100):0,saveRate=faced.length?Math.round(saves/faced.length*100):0;let cards=[['كفاءة الهجوم',attackEff+'%'],['نسبة التصدي',saveRate+'%'],['هدف/فقدان',turnovers?(goals/turnovers).toFixed(1):goals],['المساعدات',assists],['الاسترجاع',steals],['البلوك',blocks],['الإيقافات',susp],['هجمات مقدّرة',possessions]];$('analysisMetrics').innerHTML=cards.map(x=>`<div class="col-6 col-md-3"><div class="border rounded p-3 text-center"><div class="text-muted small">${x[0]}</div><h4 class="mb-0">${x[1]}</h4></div></div>`).join('');let notes=[];if(shots.length<1)notes.push('لا توجد تسديدات كافية لإصدار قراءة هجومية.');else{notes.push((goals/shots.length>=.6?'دقة التسديد قوية':'دقة التسديد تحتاج إلى تحسين')+' ('+Math.round(goals/shots.length*100)+'%).');if(turnovers>shots.length*.3)notes.push('معدل فقدان الكرة مرتفع مقارنة بعدد التسديدات؛ ركّز على القرار والتمرير تحت الضغط.');if(assists<goals*.35)notes.push('نسبة الأهداف المصنوعة بتمريرة حاسمة منخفضة؛ يمكن تحسين اللعب الجماعي.');if(faced.length&&saveRate<30)notes.push('فاعلية حراسة المرمى أقل من 30% وتحتاج مراجعة مناطق استقبال الأهداف.');if(susp>=3)notes.push('عدد الإيقافات مرتفع وقد أثّر على التوازن العددي.');if(!notes.length)notes.push('المؤشرات العامة متوازنة ولا تظهر نقطة ضعف بارزة في البيانات المسجلة.')} $('insights').innerHTML=notes.map(n=>`<li>${esc(n)}</li>`).join('');let periods={};events.forEach(e=>{let p=periods[e.period||1]||(periods[e.period||1]={g:0,sh:0,t:0,sv:0});if(e.type==='shot'&&e.team==='A'){p.sh++;if(e.result==='goal')p.g++}if(['turnover','technicalFault'].includes(e.type))p.t++;if(e.type==='save'&&e.result==='save')p.sv++});$('periodAnalysis').innerHTML=Object.entries(periods).map(([p,v])=>`<div class="d-flex justify-content-between border-bottom py-2"><b>الشوط ${esc(p)}</b><span>${v.g}/${v.sh} تسديد · ${v.t} فقدان · ${v.sv} تصدي</span></div>`).join('')||'لا توجد بيانات';let tech={};events.filter(e=>e.type==='technicalFault').forEach(e=>{let k=e.technicalLabel||'خطأ فني غير مصنف';tech[k]=(tech[k]||0)+1});$('technicalAnalysis').innerHTML=Object.entries(tech).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`<div class="d-flex justify-content-between border-bottom py-2"><span>${esc(k)}</span><b>${v}</b></div>`).join('')||'لم تسجل أخطاء فنية'}
function label(e){return e.technicalLabel||({shot:'تسديدة',save:'حراسة',turnover:'فقدان',steal:'استرجاع',technicalFault:'خطأ فني',foul:'خطأ',block:'بلوك',assist:'مساعدة',lineTouch:'دخول المنطقة',suspension:'إيقاف',substitution:'تبديل'}[e.type]||e.type)}function timeline(){$('timeline').innerHTML=events.slice().reverse().map(e=>`<tr><td>ش${esc(e.period)} · ${esc(e.matchTime||'--:--')}</td><td>${esc(e.player||'الفريق')}</td><td>${esc(label(e))}</td><td>${esc(e.result||'—')}</td></tr>`).join('')}
window.exportCsv=()=>{if(!rows)return alert('انتظر اكتمال تحميل التقرير');let lines=[['اللاعب','الأهداف','التسديدات','الدقة','التصديات','التسديدات المواجهة','نسبة التصدي','المساعدات','الاسترجاع','الفقدان','البلوك','الإيقاف'],...Object.values(rows).map(r=>[r.name,r.g,r.sh,r.sh?Math.round(r.g/r.sh*100)+'%':'0%',r.sv,r.faced,r.faced?Math.round(r.sv/r.faced*100)+'%':'0%',r.a,r.st,r.t,r.b,r.s])];downloadCsv(lines,(match.name||'match-report')+'.csv')};function downloadCsv(lines,fileName){let csv='\uFEFF'+lines.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n'),blob=new Blob([csv],{type:'text/csv;charset=utf-8;'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.style.display='none';a.href=url;a.download=fileName.replace(/[\\/:*?"<>|]/g,'-');document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(url);a.remove()},1500)};
window.editMatch=async()=>{let name=prompt('اسم المباراة',match.name);if(name===null)return;let teamA=prompt('اسم فريقنا',match.teamA);if(teamA===null)return;let teamB=prompt('اسم الخصم',match.teamB);if(teamB===null)return;let r=await fetch('/matches/'+match._id,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,teamA,teamB})}),d=await r.json();if(!r.ok||!d.success)return alert(d.message||'تعذر التعديل');match={...match,...d.match};$('title').textContent=match.name;$('subtitle').textContent=match.teamA+' × '+match.teamB+' — '+(match.status==='finished'?'منتهية':'مباشرة');alert('تم تعديل اللقاء')};window.deleteMatch=async()=>{if(match.status!=='finished')return alert('يمكن حذف اللقاء بعد إنهائه فقط');if(!confirm('حذف اللقاء وجميع أحداثه نهائياً؟'))return;let r=await fetch('/matches/'+match._id,{method:'DELETE'}),d=await r.json();if(!r.ok||!d.success)return alert(d.message||'تعذر الحذف');location.href='/match-reports'};
})();
</script>
