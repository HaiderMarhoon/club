<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header bg-info text-white">
          <h4 class="mb-0">تسجيل رمية - <%= gameStats.matchName %></h4>
        </div>
        <div class="card-body">
          <form action="/game-stats/shot/<%= gameStats._id %>" method="POST">
            <div class="mb-3">
              <label for="type" class="form-label">نوع الرمية <span class="text-danger">*</span></label>
              <select class="form-select" id="type" name="type" required>
                <option value="">اختر نوع الرمية</option>
                <option value="goal">هدف ✓</option>
                <option value="miss">خطأ ✗</option>
                <option value="blocked">محجوبة 🛡</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="zone" class="form-label">منطقة الرمية</label>
              <select class="form-select" id="zone" name="zone">
                <option value="">اختر المنطقة</option>
                <option value="left_wing">الجناح الأيسر</option>
                <option value="right_wing">الجناح الأيمن</option>
                <option value="center">الوسط</option>
                <option value="7m_line">خط السبعة أمتار</option>
                <option value="9m_line">خط التسعة أمتار</option>
                <option value="back">من الخلف</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="time" class="form-label">وقت الرمية (الدقيقة)</label>
              <input type="text" class="form-control" id="time" name="time" placeholder="مثال: 15:30">
            </div>

            <div class="mb-3">
              <label for="result" class="form-label">ملاحظات إضافية</label>
              <textarea class="form-control" id="result" name="result" rows="2" placeholder="أضف أي ملاحظات عن الرمية"></textarea>
            </div>

            <div class="d-flex gap-2 justify-content-between">
              <a href="/game-stats/edit/<%= gameStats._id %>" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> العودة
              </a>
              <button type="submit" class="btn btn-info">
                <i class="fas fa-save me-1"></i> حفظ الرمية
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Recent Shots -->
      <% if (gameStats.shotDetails && gameStats.shotDetails.length > 0) { %>
        <div class="card mt-4">
          <div class="card-header bg-light">
            <h5 class="mb-0">الرميات المسجلة</h5>
          </div>
          <div class="card-body">
            <div class="list-group">
              <% gameStats.shotDetails.forEach((shot, index) => { %>
                <div class="list-group-item">
                  <div class="d-flex justify-content-between align-items-start">
                    <div>
                      <h6 class="mb-1">
                        <span class="badge" style="background: <%= shot.type === 'goal' ? '#28a745' : shot.type === 'blocked' ? '#ffc107' : '#dc3545' %>">
                          <%= shot.type === 'goal' ? '✓ هدف' : shot.type === 'blocked' ? '🛡 محجوبة' : '✗ خطأ' %>
                        </span>
                      </h6>
                      <p class="mb-0 text-muted"><%= shot.zone ? 'المنطقة: ' + shot.zone : '' %></p>
                      <% if (shot.time) { %>
                        <p class="mb-0 text-muted">الوقت: <%= shot.time %></p>
                      <% } %>
                      <% if (shot.result) { %>
                        <p class="mb-0"><small><%= shot.result %></small></p>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
