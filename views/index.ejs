<style>.home-hero{background:linear-gradient(135deg,#10233f,#08708b);color:#fff;border-radius:20px;padding:clamp(1.5rem,5vw,4rem)}.home-logo{width:150px;height:150px;object-fit:cover;border-radius:50%;border:5px solid rgba(255,255,255,.3)}.home-action{height:100%;transition:.2s}.home-action:hover{transform:translateY(-4px)}.home-icon{font-size:2.2rem}</style>
<section class="home-hero mb-4"><div class="row align-items-center g-4"><div class="col-md-8"><div class="small mb-2">نادي التضامن لكرة اليد</div><h1>مرحباً <%= user ? user.username : 'بك' %></h1><p class="lead mb-0">إدارة الفريق، تسجيل المباراة وتحليل الأداء من مكان واحد.</p></div><div class="col-md-4 text-center"><img src="/assest/logo.jpeg" class="home-logo" alt="شعار النادي"></div></div></section>
<div class="row g-3">
 <% if (user && (user.isAdmin || user.isCoach)) { %>
 <div class="col-md-6 col-lg-4"><a class="card home-action text-decoration-none text-dark" href="/match-live"><div class="card-body"><div class="home-icon">⏱️</div><h3>المباراة المباشرة</h3><p class="text-muted">ابدأ التسجيل الفوري للنتيجة والأحداث والتبديلات.</p><span class="btn btn-primary">فتح الآن</span></div></a></div>
 <div class="col-md-6 col-lg-4"><a class="card home-action text-decoration-none text-dark" href="/match-reports"><div class="card-body"><div class="home-icon">📊</div><h3>تحليل المباريات</h3><p class="text-muted">التقارير، خرائط التسديد ومؤشرات الأداء.</p><span class="btn btn-success">عرض التقارير</span></div></a></div>
 <div class="col-md-6 col-lg-4"><a class="card home-action text-decoration-none text-dark" href="/statistics"><div class="card-body"><div class="home-icon">🏅</div><h3>إحصاءات اللاعبين</h3><p class="text-muted">مقارنة أداء لاعبي الفريق والحضور.</p><span class="btn btn-outline-primary">فتح اللوحة</span></div></a></div>
 <div class="col-md-6 col-lg-4"><div class="card home-action"><div class="card-body"><div class="home-icon">✅</div><h3>تسجيل الحضور</h3><p class="text-muted">اختر الفئة وسجّل الحضور والغياب والتأخر.</p><div class="input-group"><select id="attendanceCategory" class="form-select"><option value="under14">تحت 14</option><option value="under16">تحت 16</option><option value="under18">تحت 18</option><option value="under20">تحت 20</option><option value="man">الرجال</option></select><button class="btn btn-success" onclick="location.href='/attendance/'+document.getElementById('attendanceCategory').value">فتح</button></div></div></div></div>
 <% } %>
 <% if (currentPlayer) { %>
 <div class="col-md-6 col-lg-4"><a class="card home-action text-decoration-none text-dark" href="/listings/profile/<%= currentPlayer._id %>"><div class="card-body"><div class="home-icon">👤</div><h3>إحصائياتي</h3><p class="text-muted">أهدافك، دقة التسديد، المساعدات والأداء الدفاعي.</p><span class="btn btn-primary">عرض ملفي</span></div></a></div>
 <% } %>
 <% if (user && user.isAdmin) { %>
 <div class="col-md-6 col-lg-4"><a class="card home-action text-decoration-none text-dark" href="/listings/view"><div class="card-body"><div class="home-icon">🤾</div><h3>اللاعبون</h3><p class="text-muted">إدارة القوائم والملفات الشخصية.</p><span class="btn btn-outline-dark">إدارة اللاعبين</span></div></a></div>
 <div class="col-md-6 col-lg-4"><a class="card home-action text-decoration-none text-dark" href="/admin/create-player-account"><div class="card-body"><div class="home-icon">➕</div><h3>حساب لاعب</h3><p class="text-muted">إنشاء حساب وربطه بملف اللاعب.</p><span class="btn btn-outline-warning">إنشاء حساب</span></div></a></div>
 <% } %>
 <% if (!user) { %><div class="col-12 text-center"><a href="/auth/sign-in" class="btn btn-primary btn-lg">تسجيل الدخول للبدء</a></div><% } %>
</div>
