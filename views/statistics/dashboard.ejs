<section dir="rtl">
 <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4"><div><h1 class="h3 mb-1">لوحة الإحصاءات</h1><p class="text-muted mb-0">إحصاءات المباريات والحضور لجميع اللاعبين.</p></div><% if (user && (user.isAdmin || user.isCoach)) { %><a class="btn btn-primary" href="/match-live">تسجيل مباراة مباشرة</a><% } %></div>
 <div class="card mb-4"><div class="card-body"><form method="GET" action="/statistics" class="row g-3 align-items-end"><div class="col-md-6"><label class="form-label">فلتر الفئة</label><select class="form-select" name="category"><option value="">جميع الفئات</option><% Object.entries(categoryNames).forEach(([value,label]) => { %><option value="<%= value %>" <%= selectedCategory === value ? 'selected' : '' %>><%= label %></option><% }) %></select></div><div class="col-md-6"><button class="btn btn-primary">عرض الفئة</button> <a class="btn btn-outline-secondary" href="/statistics">إلغاء الفلتر</a></div></form></div></div>
 <div class="row g-3 mb-4"><% [['اللاعبون',players.length],['الأهداف',players.reduce((n,p)=>n+p.goals,0)],['التصديات',players.reduce((n,p)=>n+p.saves,0)],['المساعدات',players.reduce((n,p)=>n+p.assists,0)]].forEach(item => { %><div class="col-md-3 col-6"><div class="card text-center"><div class="card-body"><div class="text-muted"><%= item[0] %></div><h3><%= item[1] %></h3></div></div></div><% }) %></div>
 <div class="card"><div class="table-responsive"><table class="table table-striped align-middle mb-0"><thead><tr><th>اللاعب</th><th>الفئة</th><th>المباريات</th><th>الأهداف/التسديدات</th><th>الدقة</th><th>تصديات الحارس</th><th>مساعدات</th><th>استرجاع</th><th>فقدان</th><th>بلوك</th><th>2د</th><th>الحضور</th><th></th></tr></thead><tbody><% players.forEach(player => { %><tr><td><b><%= player.name %></b></td><td><%= player.categoryName %></td><td><%= player.matches %></td><td><%= player.goals %> / <%= player.shots %></td><td><%= player.accuracy %>%</td><td><%= player.saves %> / <%= player.faced %> (<%= player.saveRate %>%)</td><td><%= player.assists %></td><td><%= player.steals %></td><td><%= player.turnovers %></td><td><%= player.blocks %></td><td><%= player.suspensions %></td><td><%= player.attendanceRate %>%</td><td><a class="btn btn-sm btn-outline-primary" href="/listings/profile/<%= player.id %>">التفاصيل</a></td></tr><% }) %><% if (!players.length) { %><tr><td colspan="13" class="text-center text-muted py-4">لا توجد بيانات في الفئة المختارة.</td></tr><% } %></tbody></table></div></div>
</section>
