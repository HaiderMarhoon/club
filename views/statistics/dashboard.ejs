<section dir="rtl"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">لوحة الإحصاءات</h1><p class="text-muted mb-0">ملخص الحضور وإحصاءات المباريات لجميع اللاعبين.</p></div><% if (user && (user.isAdmin || user.isCoach)) { %><a class="btn btn-primary" href="/court">تسجيل مباراة مباشرة</a><% } %></div><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>اللاعب</th><th>الأهداف/التصويبات</th><th>الدقة</th><th>تصديات الحارس</th><th>الحضور</th><th>الغياب</th><th>التأخر</th><th></th></tr></thead><tbody><% players.forEach(player => { %><tr><td><%= player.name %></td><td><%= player.goals %> / <%= player.shots %></td><td><%= player.accuracy %>%</td><td><%= player.saves %> / <%= player.against %> (<%= player.saveRate %>%)</td><td><%= player.present %></td><td><%= player.absent %></td><td><%= player.late %></td><td><a class="btn btn-sm btn-outline-primary" href="/game-stats/player/<%= player.id %>">التفاصيل</a></td></tr><% }) %><% if (!players.length) { %><tr><td colspan="8" class="text-center text-muted">لا توجد بيانات بعد.</td></tr><% } %></tbody></table></div></section>
