<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up</title>
</head>

<body>
  <div class="container" style="max-width: 420px; margin: 4rem auto;">
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: 1.3rem; margin: 0;">إنشاء حساب جديد</h2>
      </div>
      <div class="card-body">
        <form action="/auth/sign-up" method="POST">
          <div class="form-group">
            <label for="username" class="form-label">اسم المستخدم</label>
            <input type="text" name="username" id="username" class="form-control" required>
          </div>
          <div class="form-group">
            <label for="password" class="form-label">كلمة المرور</label>
            <input type="password" name="password" id="password" class="form-control" required>
          </div>
          <div class="form-group">
            <label for="confirmPassword" class="form-label">تأكيد كلمة المرور</label>
            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">إنشاء الحساب</button>
        </form>
        <p style="text-align: center; margin-top: 1rem; color: #6b7280;">
          هل لديك حساب بالفعل؟ <a href="/auth/sign-in" style="color: #0ea5e9;">تسجيل الدخول</a>
        </p>
      </div>
    </div>
  </div>


</body>

</html>