<style>main.container{max-width:900px}.public-board{background:linear-gradient(135deg,#071a32,#08708b);color:#fff}.public-score{font-size:clamp(4rem,16vw,8rem);font-weight:900;line-height:1}.public-clock{font:900 clamp(2.5rem,9vw,5rem)/1 monospace;direction:ltr}.pulse{display:inline-block;width:10px;height:10px;background:#ef4444;border-radius:50%;animation:p 1.2s infinite}@keyframes p{50%{opacity:.25}}</style>
<div id="public" data-id="<%= matchId %>"><div class="card public-board"><div class="card-body text-center"><div class="mb-3"><span class="pulse"></span> متابعة مباشرة</div><h3 id="matchName">المباراة</h3><div class="row align-items-center mt-4"><div class="col-4"><h4 id="aName">فريقنا</h4><div id="aScore" class="public-score">0</div></div><div class="col-4"><div id="clock" class="public-clock">00:00</div><div>الشوط <span id="period">1</span></div></div><div class="col-4"><h4 id="bName">الخصم</h4><div id="bScore" class="public-score">0</div></div></div></div></div><div class="card mt-3"><div class="card-header">آخر الأحداث</div><div id="events" class="list-group list-group-flush"></div></div></div>
<script>
(()=>{let match;const id=document.getElementById('public').dataset.id,$=x=>document.getElementById(x),esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));function seconds(){let n=Number(match.clockSeconds||0),raw=match.clockStartedAt;if(match.clockRunning&&raw){let t=raw._seconds?raw._seconds*1000:new Date(raw).getTime();if(Number.isFinite(t))n+=Math.floor((Date.now()-t)/1000)}return n}function time(n){return String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0')}async function load(){let r=await fetch('/public/matches/'+id),d=await r.json();if(!d.success)return;match=d.match;let a=0,b=0,ev=match.eventIds||[];ev.forEach(e=>{if((e.type==='shot'||e.type==='save')&&e.result==='goal')e.team==='B'?b++:a++});$('matchName').textContent=match.name;$('aName').textContent=match.teamA;$('bName').textContent=match.teamB;$('aScore').textContent=a;$('bScore').textContent=b;$('period').textContent=match.period;$('events').innerHTML=ev.slice(-8).reverse().map(e=>`<div class="list-group-item d-flex justify-content-between"><span><b>${esc(e.player||(e.team==='B'?match.teamB:match.teamA))}</b> — ${esc({goal:'هدف',save:'تصدي',miss:'خارج',blocked:'محجوبة'}[e.result]||e.type)}</span><small>ش${esc(e.period)} · ${esc(e.matchTime||'')}</small></div>`).join('')}setInterval(()=>{if(match)$('clock').textContent=time(seconds())},500);load();setInterval(load,3000)})();
</script>
