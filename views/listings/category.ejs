<style>@media print{nav,footer,.no-print,.modal,.btn{display:none!important}body{background:#fff!important}.card{box-shadow:none!important}#playersTable{display:table!important}}</style>
<div class="container" id="categoryPage" data-category="<%= category || '' %>">
  <div style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">
      <% if (category) { %>
        لاعبين فئة <%= categoryName %>
        <% if (dateFrom || dateTo) { %><small class="d-block text-muted mt-2">الفترة: <%= dateFrom || 'البداية' %> — <%= dateTo || 'اليوم' %></small><% } %>
      <% } else { %>
        جميع اللاعبين
      <% } %>
    </h2>
    
    <% if (user && user.isAdmin) { %>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/listings/new" class="btn btn-primary">
          إضافة لاعب
        </a>
        <% if (category) { %>
          <a href="/attendance/<%= category %>" class="btn btn-primary">
            تسجيل الحضور
          </a>
        <% } else { %>
          <button class="btn btn-ghost" disabled>
            تسجيل الحضور
          </button>
        <% } %>
      </div>
    <% } %>
  </div>
  <% if (category) { %>
  <div class="card mb-4 no-print"><div class="card-header">تحديد فترة الحضور للفئة</div><div class="card-body">
    <form method="GET" action="/listings/<%= category %>" class="row g-3 align-items-end">
      <div class="col-md-4"><label class="form-label">من تاريخ</label><input type="date" class="form-control" name="from" id="categoryDateFrom" value="<%= dateFrom %>"></div>
      <div class="col-md-4"><label class="form-label">إلى تاريخ</label><input type="date" class="form-control" name="to" id="categoryDateTo" value="<%= dateTo %>"></div>
      <div class="col-md-4"><button class="btn btn-primary" type="submit">مشاهدة الفترة</button> <a class="btn btn-outline-secondary" href="/listings/<%= category %>">جميع التواريخ</a></div>
    </form>
  </div></div>
  <% } %>

  <!-- Category Filter -->
  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-body" style="padding: 1rem;">
      <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
        <a href="/listings" class="btn" style="background: <%= !category ? 'var(--primary)' : 'transparent' %>; color: <%= !category ? 'white' : 'var(--muted)' %>; border: 1px solid #e6e9ef;">
          الكل
        </a>
        <a href="/listings/under14" class="btn" style="background: <%= category === 'under14' ? 'var(--primary)' : 'transparent' %>; color: <%= category === 'under14' ? 'white' : 'var(--muted)' %>; border: 1px solid #e6e9ef;">
          تحت 14 سنة
        </a>
        <a href="/listings/under16" class="btn" style="background: <%= category === 'under16' ? 'var(--primary)' : 'transparent' %>; color: <%= category === 'under16' ? 'white' : 'var(--muted)' %>; border: 1px solid #e6e9ef;">
          تحت 16 سنة
        </a>
        <a href="/listings/under18" class="btn" style="background: <%= category === 'under18' ? 'var(--primary)' : 'transparent' %>; color: <%= category === 'under18' ? 'white' : 'var(--muted)' %>; border: 1px solid #e6e9ef;">
          تحت 18 سنة
        </a>
        <a href="/listings/under20" class="btn" style="background: <%= category === 'under20' ? 'var(--primary)' : 'transparent' %>; color: <%= category === 'under20' ? 'white' : 'var(--muted)' %>; border: 1px solid #e6e9ef;">
          تحت 20 سنة
        </a>
        <a href="/listings/man" class="btn" style="background: <%= category === 'man' ? 'var(--primary)' : 'transparent' %>; color: <%= category === 'man' ? 'white' : 'var(--muted)' %>; border: 1px solid #e6e9ef;">
          الرجال
        </a>
      </div>
    </div>
  </div>
  <!-- Summary Statistics -->
  <% if (players.length> 0) { %>
    <div class="row mb-4 g-3">
      <div class="col-md-3">
        <div class="card bg-primary text-white">
          <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-0">إجمالي اللاعبين</h6>
                <h3 class="mb-0">
                  <%= players.length %>
                </h3>
              </div>
              <i class="fas fa-users fa-2x opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-success text-white">
          <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-0">أفضل نسبة حضور</h6>
                <h3 class="mb-0">
                  <%= Math.max(...players.map(p=> p.totalRecords > 0 ? Math.round((p.presentCount / p.totalRecords) *
                    100) : 0)) %>%
                </h3>
              </div>
              <i class="fas fa-star fa-2x opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-warning text-dark">
          <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-0">متوسط الحضور</h6>
                <h3 class="mb-0">
                  <%= Math.round(players.reduce((sum, p)=> sum + (p.totalRecords > 0 ? (p.presentCount / p.totalRecords)
                    * 100 : 0), 0) / players.length) %>%
                </h3>
              </div>
              <i class="fas fa-chart-line fa-2x opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card bg-danger text-white">
          <div class="card-body py-3">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="mb-0">أسوأ نسبة حضور</h6>
                <h3 class="mb-0">
                  <%= Math.min(...players.map(p=> p.totalRecords > 0 ? Math.round((p.presentCount / p.totalRecords) *
                    100) : 0)) %>%
                </h3>
              </div>
              <i class="fas fa-exclamation-triangle fa-2x opacity-50"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

      <% if (players.length> 0) { %>
        <div class="table-responsive">
          <table class="table table-striped table-hover" id="playersTable">
            <thead class="table-dark">
              <tr>
                <th width="5%">#</th>
                <th width="20%">اسم اللاعب</th>
                <th width="10%" class="text-center">حضور</th>
                <th width="10%" class="text-center">تأخر</th>
                <th width="10%" class="text-center">غياب</th>
                <th width="15%" class="text-center">النسبة</th>
                <% if (user && user.isAdmin) { %>
                <th width="30%" class="text-center">الإجراءات</th>
                <% } %>
                <th width="15%" class="text-center">الملف الشخصي</th>
              </tr>
            </thead>
            <tbody>
              <% function getPercentageClass(percentage) { if (percentage>= 80) return 'success';
                if (percentage >= 50) return 'warning';
                return 'danger';
                }

                players.forEach((player, index) => {
                const totalRecords = player.totalRecords || 0;
                const presentCount = player.presentCount || 0;
                const lateCount = player.lateCount || 0;
                const absentCount = player.absentCount || 0;
                const percentage = totalRecords > 0 ? Math.round((presentCount / totalRecords) * 100) : 0;
                %>
                <tr>
                  <td>
                    <%= index + 1 %>
                  </td>
                  <td>
                    <div class="d-flex align-items-center">
                      <%= player.name %>
                        <% if (percentage>= 90) { %>
                          <span class="badge bg-success ms-2">ممتاز</span>
                          <% } else if (percentage>= 70) { %>
                            <span class="badge bg-primary ms-2">جيد</span>
                            <% } else if (percentage < 50 && totalRecords> 5) { %>
                              <span class="badge bg-danger ms-2">تحت الملاحظة</span>
                              <% } %>
                    </div>
                  </td>
                  <td class="text-center <%= presentCount > 0 ? 'text-success fw-bold' : '' %>">
                    <%= presentCount %>
                  </td>
                  <td class="text-center <%= lateCount > 0 ? 'text-warning fw-bold' : '' %>">
                    <%= lateCount %>
                  </td>
                  <td class="text-center <%= absentCount > 0 ? 'text-danger fw-bold' : '' %>">
                    <%= absentCount %>
                  </td>
                  <td class="text-center">
                    <div class="progress" style="height: 20px;">
                      <div class="progress-bar bg-<%= getPercentageClass(percentage) %>" role="progressbar"
                        style="width: <%= percentage %>%" aria-valuenow="<%= percentage %>" aria-valuemin="0"
                        aria-valuemax="100">
                        <%= percentage %>%
                      </div>
                    </div>
                  </td>

                  <% if (user && user.isAdmin) { %>
                  <td>
                    <div class="d-flex flex-column flex-sm-row gap-1 justify-content-center">
                      <a href="/attendance/player/<%= player._id %>" class="btn btn-sm btn-info" title="سجل الحضور">
                        <i class="fas fa-history"></i>
                        <span class="d-none d-sm-inline">الحضور</span>
                      </a>
                      <a href="/listings/<%= player._id %>/edit" class="btn btn-sm btn-warning" title="تعديل">
                        <i class="fas fa-edit"></i>
                        <span class="d-none d-sm-inline">تعديل</span>
                      </a>
                      <a href="/listings/profile/<%= player._id %>" class="btn btn-sm btn-primary" title="عرض الملف">
                        <i class="fas fa-user"></i>
                        <span class="d-none d-sm-inline">الملف</span>
                      </a>
                      <form action="/listings/<%= player._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-danger"
                          onclick="return confirm('هل أنت متأكد من حذف هذا اللاعب؟')" title="حذف">
                          <i class="fas fa-trash-alt"></i>
                          <span class="d-none d-sm-inline">حذف</span>
                        </button>
                      </form>
                    </div>
                  </td>
                  <% } %>
                  <td>
                    <div class="d-flex flex-column flex-sm-row gap-1 justify-content-center">
                      <a href="/attendance/player/<%= player._id %>" class="btn btn-sm btn-info" title="سجل الحضور">
                        <i class="fas fa-history"></i>
                        <span class="d-none d-sm-inline">الحضور</span>
                      </a>
                      <a href="/listings/profile/<%= player._id %>" class="btn btn-sm btn-primary" title=" عرض الملف">
                        <i class="fas fa-user"></i>
                        <span class="d-none d-sm-inline"></span>
                        الملف التعريفي
                      </a>
                    </div>
                  </td> 
                </tr>
                <% }) %>
            </tbody>
          </table>
        </div>

        <div class="mt-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
          <div class="text-muted">
            إجمالي اللاعبين: <%= players.length %>
              <% if (category) { %>
                | الفئة: <%= categoryName %>
                  <% } %>
          </div>
          <div class="btn-group">
            <button class="btn btn-outline-primary" onclick="printTable()">
              <i class="fas fa-print me-1"></i> طباعة
            </button>
            <button class="btn btn-outline-success" onclick="exportCategory()">
              <i class="fas fa-file-excel me-1"></i> تصدير
            </button>
          </div>
        </div>
        <% } else { %>
          <div class="alert alert-info text-center py-4">
            <i class="fas fa-info-circle fa-2x mb-3"></i>
            <h4>لا يوجد لاعبين مسجلين <% if (category) { %>في هذه الفئة<% } %>
            </h4>
          </div>
        <% } %>

</div>

<script>
  function printTable() {
    window.print();
  }

  function exportCategory() {
    const from = document.getElementById('categoryDateFrom')?.value || '';
    const to = document.getElementById('categoryDateTo')?.value || '';
    const category = document.getElementById('categoryPage').dataset.category;
    const params = new URLSearchParams({ category, from, to });
    window.location.assign('/listings/export?' + params.toString());
  }
</script>
