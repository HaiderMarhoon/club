
<div class="container" style="max-width: 500px;">
  <div class="card">
    <div class="card-header">
      <h2 style="font-size: 1.3rem; margin: 0;">إضافة لاعب جديد</h2>
    </div>
    <div class="card-body">
      <form action="/listings" method="POST">
        <div class="form-group">
          <label for="name" class="form-label">اسم اللاعب</label>
          <input type="text" class="form-control" id="name" name="name" required>
        </div>
        <div class="form-group">
          <label for="position" class="form-label">مركز اللاعب</label>
          <select class="form-control" id="position" name="position" required>
            <option value="court">لاعب ملعب</option>
            <option value="goalkeeper">حارس مرمى</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="category" class="form-label">الفئة</label>
          <select class="form-control" id="category" name="category" required>
            <option value="" selected disabled>اختر الفئة</option>
            <option value="under14">تجمع (Under 14)</option>
            <option value="under16">أشبال (Under 16)</option>
            <option value="under18">ناشئين (Under 18)</option>
            <option value="under20">تحت 20 سنة (Under 20)</option>
            <option value="man">الرجال</option>
          </select>
        </div>
        
        <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary">حفظ اللاعب</button>
          <a href="/listings" class="btn btn-ghost">إلغاء</a>
        </div>
      </form>
    </div>
  </div>
</div>
