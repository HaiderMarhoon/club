
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card shadow">
        <div class="card-header bg-primary text-white">
          <h3 class="card-title text-center">إنشاء حساب لاعب</h3>
        </div>
        
          <form action="/admin/create-player-account" method="POST" dir="rtl">
            <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger"><%= error %></div><% } %>
            <div class="mb-3">
              <label for="username" class="form-label">اسم المستخدم</label>
              <input type="text" class="form-control" id="username" name="username" value="<%= typeof formData !== 'undefined' ? (formData.username || '') : '' %>" required>
            </div>
            
            <div class="mb-3">
              <label for="password" class="form-label">كلمة المرور</label>
              <input type="password" class="form-control" id="password" name="password" required>
            </div>
            
            <div class="mb-3">
              <label for="playerId" class="form-label">اختر اللاعب</label>
              <input type="search" class="form-control mb-2" id="playerSearch" placeholder="ابحث بالاسم أو الفئة أو رقم القميص">
              <select class="form-select" id="playerId" name="playerId" required>
                <option value="">-- اختر لاعب --</option>
                <% players.forEach(player => { %>
                  <option value="<%= player._id %>" data-search="<%= player.name %> <%= player.categoryName %> <%= player.shirtNumber %>" <%= typeof formData !== 'undefined' && formData.playerId === player._id ? 'selected' : '' %> <%= player.hasAccount ? 'disabled' : '' %>><%= player.name %> — <%= player.categoryName %><%= player.shirtNumber ? ' — رقم ' + player.shirtNumber : '' %><%= player.hasAccount ? ' (لديه حساب)' : '' %></option>
                <% }); %>
              </select>
              <div class="form-text">إجمالي اللاعبين: <%= players.length %>. اللاعب المرتبط بحساب يظهر أيضًا مع توضيح حالته.</div>
            </div>
            
            <div class="d-grid">
              <button type="submit" class="btn btn-primary">إنشاء الحساب</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
(() => {
  const search = document.getElementById('playerSearch'), select = document.getElementById('playerId');
  if (!search || !select) return;
  const options = Array.from(select.options).slice(1);
  search.addEventListener('input', () => {
    const query = search.value.trim().toLocaleLowerCase('ar');
    options.forEach(option => { option.hidden = Boolean(query) && !option.dataset.search.toLocaleLowerCase('ar').includes(query); });
  });
})();
</script>
