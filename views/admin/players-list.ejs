

<div class="container py-5" dir="rtl">
  <h1 class="text-center mb-5">إدارة جميع الحسابات</h1>
  <% if (messages && messages.error) { %>
    <% messages.error.forEach(function(msg){ %>
      <div class="alert alert-danger"><%= msg %></div>
    <% }) %>
  <% } %>
  <% if (messages && messages.success) { %>
    <% messages.success.forEach(function(msg){ %>
      <div class="alert alert-success"><%= msg %></div>
    <% }) %>
  <% } %>
  
  <% if (users.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-striped">
        <thead class="table-dark">
          <tr>
            <th>اسم المستخدم</th>
            <th>اللاعب المرتبط</th>
            <th>الدور</th><th>تاريخ الإنشاء</th><th>الإجراءات</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td><%= user.username %></td>
              <td><%= user.isPlayer ? user.isPlayer.name : 'غير مرتبط' %></td>
              <td><%= user.isAdmin ? 'أدمن' : user.isCoach ? 'مدرب' : user.isPlayer ? 'لاعب' : 'مشاهد' %></td><td><%= user.createdAt && !isNaN(user.createdAt) ? user.createdAt.toLocaleDateString('ar-EG') : '—' %></td><td><a class="btn btn-sm btn-primary" href="/admin/accounts/<%= user._id %>/edit">تعديل الحساب</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="alert alert-info text-center">
      لا توجد حسابات مسجلة بعد
    </div>
  <% } %>
  
  <div class="text-center mt-4">
    <a href="/admin/create-player-account" class="btn btn-primary">
      إنشاء حساب جديد
    </a>
    <a href="/admin/add-admin" class="btn btn-secondary ms-2">
      إضافة مسؤول
    </a>
  </div>
</div>


