

<div class="container">
  <div class="card">
    <div class="card-header">
      <h2 style="font-size: 1.3rem; margin: 0;">تسجيل الحضور - <%= categoryName %></h2>
    </div>
    <div class="card-body">
      <form action="/attendance" method="POST">
        <input type="hidden" name="category" value="<%= category %>">
        
        <div class="form-group">
          <label for="date" class="form-label">تاريخ التدريب</label>
          <input type="date" class="form-control" id="date" name="date" value="<%= today %>" required>
        </div>
        
        <div style="overflow-x: auto; margin: 1.5rem 0;">
          <table class="table" style="min-width: 600px;">
            <thead>
              <tr>
                <th>اسم اللاعب</th>
                <th>الحالة</th>
                <th>ملاحظات</th>
              </tr>
            </thead>
            <tbody>
              <% players.forEach(player => { %>
                <tr>
                  <td><%= player.name %></td>
                  <td>
                    <select class="form-control" name="attendances[<%= player._id %>][status]" required style="width: auto;">
                      <option value="">اختر الحالة</option>
                      <option value="present">حاضر</option>
                      <option value="late">متأخر</option>
                      <option value="absent">غائب</option>
                    </select>
                  </td>
                  <td>
                    <input type="text" class="form-control" name="attendances[<%= player._id %>][comment]" placeholder="ملاحظات" style="width: auto;">
                  </td>
                </tr>
              <% }) %>
              </tbody>
            </table>
        </div>
        
        <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
          <button type="submit" class="btn btn-primary">حفظ الحضور</button>
          <a href="/listings/<%= category %>" class="btn btn-ghost">إلغاء</a>
        </div>
      </form>
    </div>
  </div>
</div>