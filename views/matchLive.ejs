<style>
.live-shell{max-width:1280px;margin:auto}.scoreboard{background:linear-gradient(135deg,#071512,#0b2923);color:#fff}.score{font-size:clamp(3rem,8vw,5rem);font-weight:900;line-height:1}.clock{font:800 clamp(2rem,6vw,4rem)/1 monospace;direction:ltr;color:#74e5cf}.quick{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}.quick .btn{justify-content:center;min-height:58px}.roster.active{background:#087f6a;color:#fff}.pitch{width:100%;max-width:460px;border-radius:12px;cursor:crosshair;background:#071411;touch-action:manipulation}.distribution-card{background:#0a1714;color:#eefcf8;border-color:#21433b}.distribution-card .card-header{background:#0d211c;border-color:#21433b}.event{border-right:5px solid #777}.event.goal{border-color:#10b981}.event.save{border-color:#0dcaf0}@media(min-width:768px){.quick{grid-template-columns:repeat(4,1fr)}}@media print{nav,footer,.no-print,#setup{display:none!important}body{background:#fff!important}.card{box-shadow:none!important}}
</style>
<div class="live-shell" id="app">
 <section id="setup">
  <div class="d-flex justify-content-between mb-3"><h2>بدء مباراة مباشرة</h2><a class="btn btn-outline-dark" href="/match-reports">التقارير</a></div>
  <div class="card"><div class="card-body"><div class="row g-3">
   <div class="col-md-4"><label class="form-label">اسم المباراة</label><input id="name" class="form-control" placeholder="الدوري - الجولة الأولى"></div>
   <div class="col-md-4"><label class="form-label">فريقنا</label><input id="teamAInput" class="form-control" value="فريقنا"></div>
   <div class="col-md-4"><label class="form-label">الخصم</label><input id="teamBInput" class="form-control"></div>
  </div><hr><div class="d-flex justify-content-between flex-wrap gap-2"><h5>قائمة المباراة <span id="selectedCount" class="badge bg-primary">0</span></h5><div class="d-flex gap-2 flex-wrap"><select id="categoryFilter" class="form-select" style="max-width:220px"><option value="">جميع الفئات</option><option value="under14">تحت 14</option><option value="under16">تحت 16</option><option value="under18">تحت 18</option><option value="under20">تحت 20</option><option value="man">الرجال</option></select><input id="search" class="form-control" style="max-width:280px" placeholder="بحث عن لاعب"></div></div><p class="small text-muted mt-2">اختر لاعبي الفئة، ثم انتقل إلى فئة أخرى لإضافة لاعبين منها. تبقى جميع اختياراتك محفوظة.</p><div id="picker" class="d-flex flex-wrap gap-2 my-3"></div>
  <button class="btn btn-primary btn-lg" onclick="startMatch()">بدء المباراة</button> <button id="resume" class="btn btn-success btn-lg d-none" onclick="resumeMatch()">متابعة المباراة</button>
  </div></div>
 </section>
 <section id="startersSetup" class="d-none">
  <div class="d-flex justify-content-between align-items-center mb-3"><div><h2>اختيار اللاعبين الأساسيين</h2><p class="text-muted mb-0">اختر حتى 7 لاعبين يبدأون داخل الملعب. بقية القائمة ستكون على دكة البدلاء.</p></div><span class="badge bg-primary fs-6"><span id="startersCount">0</span> / 7</span></div>
  <div class="card"><div class="card-body"><div id="startersPicker" class="row g-3"></div><hr><div class="d-flex gap-2"><button class="btn btn-primary btn-lg" onclick="confirmStartMatch()">تأكيد وفتح المباراة</button><button class="btn btn-outline-secondary" onclick="backToRoster()">العودة إلى القائمة</button></div></div></div>
 </section>
 <section id="live" class="d-none">
  <div class="card scoreboard mb-3"><div class="card-body"><div class="row text-center align-items-center">
   <div class="col-4"><div id="teamA">فريقنا</div><div id="scoreA" class="score">0</div></div>
   <div class="col-4"><div id="clock" class="clock">00:00</div><div>الشوط <span id="period">1</span></div><div class="mt-2 no-print"><button id="clockBtn" class="btn btn-sm btn-success" onclick="toggleClock()">تشغيل</button> <button class="btn btn-sm btn-outline-light" onclick="resetClock()">تصفير</button></div></div>
   <div class="col-4"><div id="teamB">الخصم</div><div id="scoreB" class="score">0</div><button class="btn btn-sm btn-outline-light no-print" onclick="opponentGoal()">+ هدف</button></div>
  </div></div></div>
  <div class="d-flex gap-2 flex-wrap mb-3 no-print"><button class="btn btn-outline-primary" onclick="nextPeriod()">الشوط التالي</button><button class="btn btn-outline-danger" onclick="undoLast()">↶ تراجع</button><button class="btn btn-outline-dark" onclick="copyLink()">رابط الجمهور</button><a id="report" class="btn btn-outline-success">التقرير</a><button class="btn btn-danger ms-auto" onclick="endMatch()">إنهاء</button></div>
  <div class="card mb-3 no-print"><div class="card-body"><div class="d-flex justify-content-between flex-wrap gap-2"><div class="btn-group"><button id="attackBtn" class="btn btn-primary" onclick="setMode('attack')">هجوم</button><button id="gkBtn" class="btn btn-outline-primary" onclick="setMode('gk')">حراسة</button></div><strong id="activeLabel">اختر اللاعب</strong></div><div id="chips" class="d-flex flex-wrap gap-2 mt-3"></div><div class="mt-3"><b>داخل الملعب:</b> <span id="onCourt">لم تحدد التشكيلة</span></div></div></div>
  <div class="row g-3 no-print"><div class="col-lg-6" id="courtCol"><div class="card h-100 distribution-card"><div class="card-header">توزيع التسديدات — الملعب</div><div class="card-body text-center"><svg id="court" class="pitch" viewBox="0 0 300 300"><rect x="5" y="5" width="290" height="290" fill="none" stroke="#e8f3f0" stroke-width="2"/><path d="M40 5 C42 92 85 115 150 115 C215 115 258 92 260 5" fill="none" stroke="#e8f3f0" stroke-width="2"/><path d="M5 54 C34 142 91 158 150 158 C209 158 266 142 295 54" fill="none" stroke="#e8f3f0" stroke-width="2" stroke-dasharray="3 3"/><line x1="146" y1="132" x2="154" y2="132" stroke="#e8f3f0" stroke-width="3"/><path d="M120 295 A30 30 0 0 1 180 295" fill="none" stroke="#60716d" stroke-width="2"/><line x1="150" y1="288" x2="150" y2="295" stroke="#e8f3f0" stroke-width="2"/><g id="courtDots"/></svg><div><span id="courtBadge" class="badge bg-secondary mt-2">اضغط على نقطة انطلاق التسديدة</span></div></div></div></div>
  <div class="col-lg-6"><div class="card h-100 distribution-card"><div class="card-header">توزيع التسديدات — المرمى (9 مناطق)</div><div class="card-body text-center"><svg id="goal" class="pitch" viewBox="0 0 300 190"><defs><pattern id="postStripe" width="28" height="28" patternUnits="userSpaceOnUse"><rect width="14" height="28" fill="#e8f3f0"/><rect x="14" width="14" height="28" fill="#078873"/></pattern></defs><path d="M30 175 V25 H270 V175" fill="none" stroke="url(#postStripe)" stroke-width="12"/><path d="M30 75H270M30 125H270M110 25V175M190 25V175" stroke="#73827e" stroke-width="2" stroke-dasharray="7 7"/><path d="M5 25H295M110 5V185M190 5V185" stroke="#42534f" stroke-width="1.5" stroke-dasharray="6 8"/><g id="goalDots"/></svg><div><span id="goalBadge" class="badge bg-secondary mt-2">اضغط على منطقة وصول الكرة</span> <button class="btn btn-sm btn-outline-danger mt-2" onclick="setGoalZone('outside')">خارج المرمى</button></div></div></div></div></div>
  <div id="attackControls" class="card mt-3 no-print"><div class="card-body"><div class="row g-2 mb-3"><div class="col-md-6"><select id="shotType" class="form-select"><option value="6m">6 متر</option><option value="9m">9 متر</option><option value="7m">7 متر</option><option value="wing">جناح</option><option value="fastBreak">هجمة مرتدة</option><option value="breakthrough">اختراق</option></select></div><div class="col-md-6"><select id="assist" class="form-select"><option value="">بدون تمريرة حاسمة</option></select></div></div><div class="quick"><button class="btn btn-success" onclick="shot('goal')">⚽ هدف</button><button class="btn btn-danger" onclick="shot('miss')">✕ خارج</button><button class="btn btn-warning" onclick="shot('blocked')">🛡 محجوبة</button><button class="btn btn-info" onclick="shot('save')">🧤 تصدي</button></div><hr><label class="form-label">تسجيل خطأ فني محدد</label><div class="input-group mb-3"><select id="technicalCode" class="form-select"></select><button class="btn btn-danger" onclick="quickEvent('technicalFault')">تسجيل الخطأ</button></div><div class="quick" id="quickEvents"></div></div></div>
  <div id="gkControls" class="card mt-3 d-none no-print"><div class="card-body"><p>اختر الحارس، ثم اختر مكان انطلاق تصويبة الخصم من الملعب وموقع وصول الكرة في المرمى.</p><label class="form-label">نوع تصويبة الخصم</label><select id="gkShotType" class="form-select mb-3"><option value="6m">6 متر</option><option value="9m">9 متر</option><option value="7m">7 متر</option><option value="wing">جناح</option><option value="fastBreak">هجمة مرتدة</option><option value="breakthrough">اختراق</option></select><div class="quick"><button class="btn btn-success" onclick="gk('save')">🧤 تصدي</button><button class="btn btn-danger" onclick="gk('goal')">⚽ هدف مستقبَل</button></div></div></div>
  <div class="card mt-3 no-print"><div class="card-header">التبديلات والتشكيلة</div><div class="card-body"><div id="subs" class="row g-2"></div></div></div><div id="msg" class="mt-3"></div>
  <div class="row g-3 mt-1"><div class="col-lg-8"><div class="card"><div class="card-header">إحصائيات اللاعبين</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>اللاعب</th><th>هدف</th><th>تسديد</th><th>%</th><th>تصدي</th><th>مساعدة</th><th>فقدان</th><th>2د</th></tr></thead><tbody id="stats"></tbody></table></div></div></div><div class="col-lg-4"><div class="card"><div class="card-header">آخر الأحداث</div><div id="events" class="list-group list-group-flush"></div></div></div></div>
 </section>
</div>
<script>
(()=>{const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));let players=[],roster=[],active=null,match=null,eventList=[],mode='attack',courtPoint=null,goalZone=null,goalPoint=null,onCourt=new Set(),selectedPlayers=new Set(),selectedStarters=new Set(),pendingSetup=null,timer;const requestedMatch=new URLSearchParams(location.search).get('resume'),saved=requestedMatch||sessionStorage.getItem('ml_matchId');if(saved)$('resume').classList.remove('d-none');
const quick={turnover:'فقدان كرة',steal:'استرجاع',foul:'خطأ',block:'بلوك دفاعي',assist:'تمريرة حاسمة',lineTouch:'دخول المنطقة',suspension:'إيقاف دقيقتين',yellowCard:'بطاقة صفراء',redCard:'بطاقة حمراء'};const technical={steps:'المشي أكثر من 3 خطوات',badPass:'تمريرة خاطئة',doubleDribble:'تنطيط مزدوج',heldBall:'الاحتفاظ بالكرة أكثر من 3 ثوانٍ',foot:'لمس الكرة بالقدم أو أسفل الركبة',offensiveFoul:'خطأ هجومي',passivePlay:'لعب سلبي',goalArea:'دخول منطقة المرمى',lineTouch:'لمس/تجاوز خط المنطقة',illegalSubstitution:'تبديل خاطئ',wrongThrowOff:'تنفيذ خاطئ لرمية البداية',wrongThrowIn:'تنفيذ خاطئ للرمية الجانبية',wrongFreeThrow:'تنفيذ خاطئ للرمية الحرة',wrongGoalkeeperThrow:'تنفيذ خاطئ لرمية الحارس',wrong7m:'تنفيذ خاطئ لرمية 7 أمتار',threeMeterDistance:'عدم احترام مسافة 3 أمتار',delayRestart:'تأخير استئناف اللعب',ballOutDribble:'خروج الكرة أثناء التنطيط',goalkeeperBallReturn:'إعادة الكرة للحارس داخل المنطقة',goalkeeperOutsideArea:'خروج الحارس بالكرة من المنطقة',extraPlayer:'لاعب زائد داخل الملعب'};$('quickEvents').innerHTML=Object.entries(quick).map(([k,v])=>`<button class="btn btn-outline-secondary" onclick="quickEvent('${k}')">${v}</button>`).join('');$('technicalCode').innerHTML=Object.entries(technical).map(([k,v])=>`<option value="${k}">${v}</option>`).join('');
fetch('/players').then(r=>r.json()).then(x=>{players=x;picker();if(requestedMatch)resumeMatch()});$('search').oninput=picker;$('categoryFilter').onchange=picker;function picker(){let q=$('search').value.trim(),cat=$('categoryFilter').value,categoryNames={under14:'تحت 14',under16:'تحت 16',under18:'تحت 18',under20:'تحت 20',man:'الرجال'};$('picker').innerHTML=players.filter(p=>(!cat||p.category===cat)&&(!q||p.name.includes(q))).map(p=>`<label class="border rounded p-2 ${selectedPlayers.has(p._id)?'bg-primary text-white':''}"><input type="checkbox" value="${esc(p._id)}" ${selectedPlayers.has(p._id)?'checked':''} onchange="toggleRosterChoice('${esc(p._id)}',this.checked)"> ${esc(p.name)} <small>(${esc(categoryNames[p.category]||p.category||'—')})</small></label>`).join('')||'<div class="alert alert-light w-100">لا يوجد لاعبون في هذه الفئة</div>';$('selectedCount').textContent=selectedPlayers.size}window.toggleRosterChoice=(id,checked)=>{checked?selectedPlayers.add(id):selectedPlayers.delete(id);picker()};
window.startMatch=()=>{roster=players.filter(p=>selectedPlayers.has(p._id));if(!roster.length)return alert('اختر لاعباً واحداً على الأقل');pendingSetup={name:$('name').value||'مباراة',teamA:$('teamAInput').value||'فريقنا',teamB:$('teamBInput').value||'الخصم',period:'1',roster:roster.map(p=>({_id:p._id,name:p.name,number:p.number||p.shirtNumber||'',category:p.category||''}))};selectedStarters=new Set();$('setup').classList.add('d-none');$('startersSetup').classList.remove('d-none');renderStarters()};function renderStarters(){let categoryNames={under14:'تحت 14',under16:'تحت 16',under18:'تحت 18',under20:'تحت 20',man:'الرجال'};$('startersPicker').innerHTML=roster.map(p=>`<div class="col-md-4"><label class="d-flex align-items-center gap-2 border rounded p-3 ${selectedStarters.has(p._id)?'bg-primary text-white':''}"><input type="checkbox" ${selectedStarters.has(p._id)?'checked':''} onchange="toggleStarter('${esc(p._id)}',this.checked)"><span><b>${esc(p.number?'#'+p.number+' ':'')}${esc(p.name)}</b><small class="d-block">${esc(categoryNames[p.category]||p.category||'')}</small></span></label></div>`).join('');$('startersCount').textContent=selectedStarters.size}window.toggleStarter=(id,checked)=>{if(checked&&selectedStarters.size>=7){alert('الحد الأقصى داخل الملعب هو 7 لاعبين');return renderStarters()}checked?selectedStarters.add(id):selectedStarters.delete(id);renderStarters()};window.backToRoster=()=>{$('startersSetup').classList.add('d-none');$('setup').classList.remove('d-none')};window.confirmStartMatch=async()=>{if(!selectedStarters.size)return alert('اختر لاعباً أساسياً واحداً على الأقل');let d=await api('/matches',{method:'POST',body:JSON.stringify({...pendingSetup,startingLineup:[...selectedStarters]})});match=d.match;sessionStorage.setItem('ml_matchId',match._id);$('startersSetup').classList.add('d-none');open()};
window.resumeMatch=async()=>{let d=await api('/matches/'+saved);match=d.match;roster=match.roster||players;sessionStorage.setItem('ml_matchId',match._id);open()};function open(){$('setup').classList.add('d-none');$('live').classList.remove('d-none');$('report').href='/match-report/'+match._id;renderRoster();refresh();clearInterval(timer);timer=setInterval(()=>$('clock').textContent=timeText(seconds()),500)}
function renderRoster(){$('chips').innerHTML=roster.map(p=>`<button class="btn btn-outline-dark roster" data-id="${esc(p._id)}">${esc(p.name)}</button>`).join('');document.querySelectorAll('.roster').forEach(b=>b.onclick=()=>select(b.dataset.id));$('assist').innerHTML='<option value="">بدون تمريرة حاسمة</option>'+roster.map(p=>`<option value="${esc(p._id)}">${esc(p.name)}</option>`).join('');renderSubs()};function select(id){active=roster.find(p=>p._id===id);document.querySelectorAll('.roster').forEach(b=>b.classList.toggle('active',b.dataset.id===id));$('activeLabel').textContent='اللاعب: '+active.name}
window.setMode=m=>{mode=m;$('attackBtn').className='btn '+(m==='attack'?'btn-primary':'btn-outline-primary');$('gkBtn').className='btn '+(m==='gk'?'btn-primary':'btn-outline-primary');$('courtCol').classList.remove('d-none');$('attackControls').classList.toggle('d-none',m!=='attack');$('gkControls').classList.toggle('d-none',m!=='gk');$('courtBadge').textContent=m==='gk'?'حدد مكان تصويبة الخصم':'اضغط على نقطة انطلاق التسديدة'};
function seconds(){let n=Number(match.clockSeconds||0);if(match.clockRunning&&match.clockStartedAt){let raw=match.clockStartedAt,t=raw._seconds?raw._seconds*1000:new Date(raw).getTime();if(Number.isFinite(t))n+=Math.floor((Date.now()-t)/1000)}return Math.max(0,n)}function timeText(n){return String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0')};async function update(body){let d=await api('/matches/'+match._id,{method:'PUT',body:JSON.stringify(body)});match={...match,...d.match};header()}
window.toggleClock=()=>update({clockRunning:!match.clockRunning,clockSeconds:seconds(),clockStartedAt:!match.clockRunning?new Date().toISOString():null});window.resetClock=()=>confirm('تصفير المؤقت؟')&&update({clockSeconds:0,clockRunning:false,clockStartedAt:null});window.nextPeriod=()=>update({period:String(Number(match.period||1)+1),clockSeconds:0,clockRunning:false,clockStartedAt:null});
function base(){return{matchId:match._id,period:String(match.period||1),matchTime:timeText(seconds()),team:'A',playerId:active&&active._id,player:active&&active.name}}async function add(body){let d=await api('/events',{method:'POST',body:JSON.stringify({...base(),...body})});eventList.push(d.event);flash('تم التسجيل',true);await refresh()}
window.shot=async result=>{if(!active)return flash('اختر اللاعب');if(!courtPoint)return flash('حدد مكان التسديدة');if(!goalZone)return flash('حدد منطقة المرمى');let a=roster.find(p=>p._id===$('assist').value);await add({type:'shot',result,shotType:$('shotType').value,shotLocation:`${courtPoint.x},${courtPoint.y}`,goalDirection:goalZone,goalLocation:goalPoint?`${goalPoint.x},${goalPoint.y}`:null,assistPlayerId:a&&a._id,assistPlayer:a&&a.name});courtPoint=goalZone=goalPoint=null;$('courtBadge').textContent='حدد المكان';$('goalBadge').textContent='حدد المنطقة'};window.gk=async result=>{if(!active)return flash('اختر الحارس');if(!courtPoint)return flash('حدد مكان تصويبة الخصم في الملعب');if(!goalZone)return flash('حدد موقع الكرة في المرمى');await add({team:result==='goal'?'B':'A',type:'save',result,shotType:$('gkShotType').value,shotLocation:`${courtPoint.x},${courtPoint.y}`,goalDirection:goalZone,goalLocation:goalPoint?`${goalPoint.x},${goalPoint.y}`:null});courtPoint=goalZone=goalPoint=null;$('courtBadge').textContent='حدد مكان تصويبة الخصم';$('goalBadge').textContent='حدد المنطقة'};window.quickEvent=type=>{if(!active)return flash('اختر اللاعب');let body={type,result:type==='suspension'?'2min':''};if(type==='technicalFault'){body.technicalCode=$('technicalCode').value;body.technicalLabel=technical[body.technicalCode]}return add(body)};window.opponentGoal=()=>add({team:'B',playerId:null,player:null,type:'shot',result:'goal'});
window.undoLast=async()=>{let e=eventList.at(-1);if(!e)return flash('لا يوجد حدث');if(confirm('التراجع عن آخر حدث؟')){await api('/events/'+e._id,{method:'DELETE'});await refresh()}};window.toggleCourt=async id=>{active=roster.find(p=>p._id===id);let entering=!onCourt.has(id);await add({type:'substitution',result:entering?'in':'out'})};function renderSubs(){$('subs').innerHTML=roster.map(p=>`<div class="col-md-4"><div class="d-flex justify-content-between border rounded p-2"><span>${esc(p.name)}</span><button class="btn btn-sm ${onCourt.has(p._id)?'btn-danger':'btn-success'}" onclick="toggleCourt('${esc(p._id)}')">${onCourt.has(p._id)?'خروج':'دخول'}</button></div></div>`).join('');$('onCourt').textContent=roster.filter(p=>onCourt.has(p._id)).map(p=>p.name).join('، ')||'لم تحدد التشكيلة'}
$('court').onclick=e=>{let p=point($('court'),e);courtPoint={x:Math.round(p.x/3),y:Math.round(p.y/3)};$('courtBadge').textContent=`${courtPoint.x}%، ${courtPoint.y}%`;dot('courtDots',p.x,p.y,'#fff',true)};$('goal').onclick=e=>{let p=point($('goal'),e);goalPoint={x:Math.max(0,Math.min(100,Math.round((p.x-30)/2.4))),y:Math.max(0,Math.min(100,Math.round((p.y-25)/1.5)))};setGoalZone((p.y<75?'top':p.y<125?'mid':'bottom')+'-'+(p.x<110?'left':p.x<190?'center':'right'));dot('goalDots',p.x,p.y,'#fff',true)};function point(s,e){let r=s.getBoundingClientRect(),v=s.viewBox.baseVal;return{x:(e.clientX-r.left)/r.width*v.width,y:(e.clientY-r.top)/r.height*v.height}}window.setGoalZone=z=>{goalZone=z;if(z==='outside'){goalPoint=null;document.querySelectorAll('#goalDots .mark').forEach(n=>n.remove())}$('goalBadge').textContent=z==='outside'?'خارج المرمى':z};function dot(id,x,y,color,mark=false){let g=$(id);if(mark)g.querySelectorAll('.mark').forEach(n=>n.remove());let c=document.createElementNS('http://www.w3.org/2000/svg','circle');Object.entries({cx:x,cy:y,r:mark?7:6,fill:color,stroke:'#06100e','stroke-width':2}).forEach(([k,v])=>c.setAttribute(k,v));if(mark)c.classList.add('mark');g.appendChild(c)}
async function refresh(){let d=await api('/matches/'+match._id);match=d.match;eventList=match.eventIds||[];onCourt=new Set(match.startingLineup||[]);eventList.filter(e=>e.type==='substitution').forEach(e=>e.result==='in'?onCourt.add(e.playerId):onCourt.delete(e.playerId));header();paint();renderSubs()};function header(){let a=0,b=0;eventList.forEach(e=>{if((e.type==='shot'||e.type==='save')&&e.result==='goal')e.team==='B'?b++:a++});$('scoreA').textContent=a;$('scoreB').textContent=b;$('teamA').textContent=match.teamA;$('teamB').textContent=match.teamB;$('period').textContent=match.period;$('clockBtn').textContent=match.clockRunning?'إيقاف':'تشغيل'}
function paint(){let rows={};roster.forEach(p=>rows[p._id]={...p,g:0,sh:0,sv:0,a:0,t:0,s:0});eventList.forEach(e=>{let r=rows[e.playerId];if(r){if(e.type==='shot'){r.sh++;if(e.result==='goal')r.g++}if(e.type==='save'&&e.result==='save')r.sv++;if(e.type==='assist')r.a++;if(['turnover','technicalFault'].includes(e.type))r.t++;if(e.type==='suspension')r.s++}if(e.assistPlayerId&&rows[e.assistPlayerId])rows[e.assistPlayerId].a++});$('stats').innerHTML=Object.values(rows).map(r=>`<tr><td>${esc(r.name)}</td><td>${r.g}</td><td>${r.sh}</td><td>${r.sh?Math.round(r.g/r.sh*100):0}%</td><td>${r.sv}</td><td>${r.a}</td><td>${r.t}</td><td>${r.s}</td></tr>`).join('');$('events').innerHTML=eventList.slice(-10).reverse().map(e=>`<div class="list-group-item event ${esc(e.result)}"><b>${esc(e.player||(e.team==='B'?match.teamB:match.teamA))}</b> — ${esc(label(e))}<small class="d-block text-muted">ش${esc(e.period)} · ${esc(e.matchTime||'--:--')}</small></div>`).join('')||'<div class="p-3">لا توجد أحداث</div>';plot()};function label(e){return e.technicalLabel||({goal:'هدف',miss:'خارج',blocked:'محجوبة',save:'تصدي',in:'دخول',out:'خروج'}[e.result]||quick[e.type]||e.type)}function plot(){$('courtDots').innerHTML='';$('goalDots').innerHTML='';eventList.filter(e=>e.type==='shot').forEach(e=>{let color={goal:'#10b981',miss:'#ef4444',blocked:'#f59e0b',save:'#0dcaf0'}[e.result]||'#777';if(e.shotLocation){let[x,y]=e.shotLocation.split(',').map(Number);dot('courtDots',x*3,y*3,color)}if(e.goalDirection&&e.goalDirection!=='outside'){if(e.goalLocation){let[x,y]=e.goalLocation.split(',').map(Number);dot('goalDots',30+x*2.4,25+y*1.5,color)}else{let[r,c]=e.goalDirection.split('-');dot('goalDots',{left:70,center:150,right:230}[c],{top:50,mid:100,bottom:150}[r],color)}}})}
window.copyLink=async()=>{let u=location.origin+'/live-score/'+match._id;try{await navigator.clipboard.writeText(u);flash('تم نسخ الرابط',true)}catch{prompt('انسخ الرابط',u)}};window.endMatch=async()=>{if(confirm('إنهاء المباراة؟')){await update({status:'finished',clockSeconds:seconds(),clockRunning:false,clockStartedAt:null});sessionStorage.removeItem('ml_matchId');location.href='/match-report/'+match._id}};function flash(s,ok=false){$('msg').innerHTML=`<div class="alert ${ok?'alert-success':'alert-danger'}">${esc(s)}</div>`;setTimeout(()=>$('msg').innerHTML='',2000)}async function api(url,opt={}){let r=await fetch(url,{headers:{'Content-Type':'application/json'},...opt}),d=await r.json();if(!r.ok||d.success===false)throw Error(d.message||'تعذر التنفيذ');return d}
})();
</script>
