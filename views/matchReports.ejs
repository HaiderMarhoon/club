<style>@media print{nav,footer,.no-print{display:none!important}body{background:#fff!important}.card{box-shadow:none!important}#matchesTable{display:table!important}}</style>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2>المباريات والتقارير</h2><p id="rangeTitle" class="text-muted mb-0">جميع المباريات</p></div><a class="btn btn-primary no-print" href="/match-live">مباراة جديدة</a></div>
<div class="card mb-3 no-print"><div class="card-body"><div class="row g-3 align-items-end">
 <div class="col-md-3"><label class="form-label">من تاريخ</label><input id="dateFrom" type="date" class="form-control"></div>
 <div class="col-md-3"><label class="form-label">إلى تاريخ</label><input id="dateTo" type="date" class="form-control"></div>
 <div class="col-md-6"><div class="d-flex gap-2 flex-wrap"><button class="btn btn-primary" onclick="applyFilter()">مشاهدة الفترة</button><button class="btn btn-outline-secondary" onclick="clearFilter()">جميع التواريخ</button><button class="btn btn-dark" onclick="printFiltered()">طباعة الفترة</button><button id="exportMatchesBtn" class="btn btn-success" onclick="exportFiltered()" disabled>تصدير إلى Excel</button></div></div>
</div><div id="filterMessage" class="small text-muted mt-3">اختر تاريخ البداية والنهاية، أو اترك أحدهما فارغاً.</div></div></div>
<div class="card"><div class="card-body"><div id="loading">جارٍ تحميل المباريات…</div><div class="table-responsive"><table id="matchesTable" class="table d-none"><thead><tr><th>المباراة</th><th>الفريقان</th><th>الحالة</th><th>التاريخ</th><th class="no-print"></th></tr></thead><tbody id="matches"></tbody></table></div></div></div>
<script>
const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));let allMatches=[],visibleMatches=[];
function matchDate(m){let v=m.createdAt;if(!v)return null;if(v._seconds||v.seconds)return new Date((v._seconds||v.seconds)*1000);let d=new Date(v);return isNaN(d)?null:d}
fetch('/matches').then(r=>r.json()).then(ms=>{allMatches=ms;$('loading').remove();$('matchesTable').classList.remove('d-none');$('exportMatchesBtn').disabled=false;applyFilter()}).catch(()=>{$('loading').className='alert alert-danger';$('loading').textContent='تعذر تحميل المباريات'});
window.applyFilter=()=>{let from=$('dateFrom').value?new Date($('dateFrom').value+'T00:00:00'):null,to=$('dateTo').value?new Date($('dateTo').value+'T23:59:59.999'):null;if(from&&to&&from>to){$('filterMessage').textContent='تاريخ البداية يجب أن يكون قبل تاريخ النهاية';return}visibleMatches=allMatches.filter(m=>{let d=matchDate(m);return(!from||d&&d>=from)&&(!to||d&&d<=to)});let range=from||to?`${from?'من '+from.toLocaleDateString('ar-SA'):''} ${to?'إلى '+to.toLocaleDateString('ar-SA'):''}`:'جميع المباريات';$('rangeTitle').textContent=range;$('filterMessage').textContent=`عدد المباريات في النتائج: ${visibleMatches.length}`;render()};
window.clearFilter=()=>{$('dateFrom').value='';$('dateTo').value='';applyFilter()};
function render(){$('matches').innerHTML=visibleMatches.map(m=>{let d=matchDate(m),dateText=d?d.toLocaleDateString('ar-SA'):'—';return `<tr><td>${esc(m.name)}</td><td>${esc(m.teamA)} × ${esc(m.teamB)}</td><td><span class="badge ${m.status==='finished'?'bg-secondary':'bg-success'}">${m.status==='finished'?'منتهية':'مباشرة'}</span></td><td>${dateText}</td><td class="no-print"><a class="btn btn-sm btn-outline-primary" href="/match-report/${m._id}">فتح التقرير</a></td></tr>`}).join('')||'<tr><td colspan="5" class="text-center text-muted">لا توجد مباريات في الفترة المحددة</td></tr>'}
window.printFiltered=()=>{if(!visibleMatches.length)return alert('لا توجد مباريات في الفترة المحددة');window.print()};
window.exportFiltered=()=>{if(!visibleMatches.length)return alert('لا توجد مباريات للتصدير');let lines=[['اسم المباراة','فريقنا','الخصم','الحالة','التاريخ'],...visibleMatches.map(m=>[m.name,m.teamA,m.teamB,m.status==='finished'?'منتهية':'مباشرة',matchDate(m)?.toLocaleDateString('ar-SA')||''])];downloadCsv(lines,'تقارير-المباريات.csv')};
function downloadCsv(lines,fileName){let csv='\uFEFF'+lines.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n'),blob=new Blob([csv],{type:'text/csv;charset=utf-8;'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.style.display='none';a.href=url;a.download=fileName;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(url);a.remove()},1500)}
</script>
